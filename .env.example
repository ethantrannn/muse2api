# Filled in by `npm run import-cookies` (muse.ai cookies from your logged-in Chrome)
MUSE_COOKIES=""

# Optional
PORT=8787
HOST=127.0.0.1
# Require `Authorization: Bearer <API_KEY>` when set
API_KEY=
MUSE_MODEL_ID=muse
MUSE_TIMEOUT_MS=600000
MUSE_TIMEZONE=Asia/Saigon
# Side chats are deleted after each request; set true to keep them
MUSE_KEEP_SIDECHATS=false
